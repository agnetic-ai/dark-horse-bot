# ==========================================
# DARK HORSE (GENESIS) AUTOMATION CONFIG
# ==========================================

# Data Directory (Default: current script directory)
# DHORSE_DATA_DIR=/opt/dark-horse

# Tor SOCKS5 Proxy Configuration
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050

# Minimum claimable points threshold before claiming (Default: 1.0)
MIN_CLAIM_THRESHOLD=1.0

# Telegram Alerting (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
